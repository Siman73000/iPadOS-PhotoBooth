# Redis Cloud connection string.
# Use the TLS connection string supplied by Redis Cloud for production.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:YOUR_PORT

# Optional. Controls whether stored photos expire. Leave blank for no expiration.
# Example: 2592000 = 30 days.
PHOTO_TTL_SECONDS=

# Maximum JPEG upload size. Keep below Vercel's 4.5 MB function body limit.
MAX_PHOTO_BYTES=4200000
