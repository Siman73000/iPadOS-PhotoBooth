# Create an Upstash Redis database and add these values to Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Controls whether stored photos expire. Leave blank for no expiration.
# Example: 2592000 = 30 days.
PHOTO_TTL_SECONDS=

# Optional. Used only for rate limiting and diagnostics. Example: 6.
MAX_PHOTO_BYTES=4200000
